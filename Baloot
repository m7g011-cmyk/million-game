<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>لعبة البلوت أونلاين ♠️</title>
    
    <script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-database-compat.js"></script>

    <style>
        body { background-color: #064E3B; color: white; font-family: system-ui, -apple-system, sans-serif; margin: 0; padding: 12px; display: flex; justify-content: center; align-items: center; min-height: 100vh; box-sizing: border-box; }
        .card { background-color: #022C22; border: 2px solid #F59E0B; border-radius: 16px; padding: 16px; width: 100%; max-width: 440px; text-align: center; box-shadow: 0 10px 25px rgba(0,0,0,0.6); }
        h1 { color: #F59E0B; margin-bottom: 6px; font-size: 24px; }
        input, select { width: 100%; padding: 10px; margin: 6px 0; border-radius: 8px; border: 1px solid #065F46; background-color: #064E3B; color: white; box-sizing: border-box; font-size: 14px; text-align: center; }
        button { width: 100%; padding: 11px; margin: 5px 0; border-radius: 8px; border: none; font-weight: bold; font-size: 14px; cursor: pointer; transition: 0.2s; }
        button:active { transform: scale(0.98); }
        .btn-primary { background-color: #F59E0B; color: #000; }
        .btn-success { background-color: #10B981; color: #fff; }
        .btn-danger { background-color: #EF4444; color: #fff; }
        .btn-secondary { background-color: #475569; color: #fff; }
        
        .score-board { display: flex; justify-content: space-around; background: #064E3B; border: 1px solid #10B981; border-radius: 10px; padding: 10px; margin: 10px 0; font-weight: bold; }
        .score-box { text-align: center; }
        .score-val { font-size: 20px; color: #F59E0B; }
        
        .players-list { background-color: #064E3B; border: 1px solid #065F46; border-radius: 10px; padding: 8px; margin: 10px 0; text-align: right; }
        .player-item { display: flex; justify-content: space-between; align-items: center; padding: 8px 10px; margin: 4px 0; background: #022C22; border-radius: 6px; font-size: 13px; }
        .player-item.active-turn { border: 2px solid #F59E0B; background: #15803D; }
        
        .cards-container { display: flex; justify-content: center; gap: 4px; margin: 10px 0; flex-wrap: wrap; }
        .playing-card { background-color: #FFF; color: #000; font-weight: bold; font-size: 13px; padding: 8px 4px; border-radius: 6px; width: 42px; height: 58px; border: 1px solid #CBD5E1; text-align: center; box-shadow: 0 4px 6px rgba(0,0,0,0.3); display: flex; flex-direction: column; justify-content: center; cursor: pointer; }
        .playing-card.red { color: #DC2626; }
        
        .bidding-box { background-color: #064E3B; border: 1px solid #F59E0B; border-radius: 8px; padding: 10px; margin-top: 10px; }
        .hidden { display: none; }
        .flex-row { display: flex; gap: 6px; }
    </style>
</head>
<body>

<div class="card">
    <h1>لعبة البلوت ♠️</h1>

    <!-- النشرة النتيجة الكلية -->
    <div class="score-board">
        <div class="score-box">
            <div>لنا 🟩</div>
            <div class="score-val" id="score-us">0</div>
        </div>
        <div style="font-size:20px; color:#F59E0B;">VS</div>
        <div class="score-box">
            <div>لهم 🟥</div>
            <div class="score-val" id="score-them">0</div>
        </div>
    </div>

    <!-- 1. اللوبي والتسجيل -->
    <div id="lobby-screen">
        <input type="text" id="player-name" placeholder="اكتب اسمك للبدء" />
        <button class="btn-primary" onclick="createRoom()">إنشاء طاولة بلوت جديدة</button>
        <button class="btn-secondary" onclick="startVsBots()">اللعب ضد الكمبيوتر 🤖</button>
        <hr style="border-color: #065F46; margin: 12px 0;">
        <input type="number" id="room-code-input" placeholder="رمز الغرفة" />
        <button class="btn-success" onclick="joinRoom()">انضمام لطاولة</button>
    </div>

    <!-- 2. الانتظار -->
    <div id="waiting-screen" class="hidden">
        <h3>رمز الطاولة: <span id="current-room-display" style="color:#F59E0B;"></span></h3>
        <p style="font-size: 13px; color: #A7F3D0;">اللاعبون المتواجدون (<span id="player-count">1</span>/4)</p>
        <div class="players-list" id="players-container"></div>
        <button class="btn-primary" id="start-game-btn" onclick="startGame()">بدء التوزيع واللعب 🚀</button>
    </div>

    <!-- 3. طاولة اللعب والحراج -->
    <div id="game-screen" class="hidden">
        <div style="font-size: 12px; color: #F59E0B; margin-bottom: 4px;">
            الموزع: <strong id="dealer-name">-</strong> | المكشوفة: <strong id="revealed-card">-</strong>
        </div>

        <div class="players-list" id="game-board-players"></div>

        <!-- مرحلة الشراء والتسويم (أول / ثاني / صن / حكم) -->
        <div id="bidding-screen" class="bidding-box hidden">
            <h4 style="margin:2px 0; color:#F59E0B;">مرحلة الحراج والشراء 📢</h4>
            <div id="bid-round-title" style="font-size:12px; margin-bottom:6px;">الدور الأول (على المكشوف):</div>
            <div class="flex-row">
                <button class="btn-primary" onclick="makeBid('sun')">صن ☀️</button>
                <button class="btn-success" onclick="makeBid('hokm')">حكم 🌙</button>
                <button class="btn-danger" onclick="makeBid('pass')">بس (بسس) ✋</button>
            </div>
            <div class="flex-row" style="margin-top:4px;">
                <button class="btn-secondary" onclick="makeBid('ashkal')">أشكال 🎴</button>
            </div>
        </div>

        <!-- أوراق اللاعب الخاصة -->
        <div style="margin: 6px 0;">
            <div style="font-size: 12px; color: #CBD5E1;">أوراقك الخاصة:</div>
            <div id="my-cards" class="cards-container"></div>
        </div>

        <!-- ساحة لعب الورق (الفرشة) -->
        <div id="table-played-cards" class="cards-container" style="background:#064E3B; border:1px solid #10B981; border-radius:8px; min-height:70px; align-items:center;">
            <span style="font-size:12px; color:#A7F3D0;">الأوراق النازلة في الفرشة</span>
        </div>
    </div>
</div>

<script>
    const firebaseConfig = {
        apiKey: "AIzaSyBRtQGiXgrzm7SoFwymT39OBZVtN0Pz-Ys",
        authDomain: "million-game-1ec89.firebaseapp.com",
        databaseURL: "https://million-game-1ec89-default-rtdb.firebaseio.com",
        projectId: "million-game-1ec89",
        storageBucket: "million-game-1ec89.firebasestorage.app",
        messagingSenderId: "6658146268",
        appId: "1:6658146268:web:0467d3f63e11b818fb9919"
    };

    firebase.initializeApp(firebaseConfig);
    const db = firebase.database();

    let currentRoomCode = null;
    let myName = "";
    let isHost = false;

    const SUITS = ['♠️', '♥️', '♦️', '♣️'];
    const RANKS_SUN = ['A', '10', 'K', 'Q', 'J', '9', '8', '7']; // ترتيب قوة الصن
    const RANKS_HOKM = ['J', '9', 'A', '10', 'K', 'Q', '8', '7']; // ترتيب قوة الحكم

    function saveName(name) { myName = name; localStorage.setItem('baloot_player_name', name); }

    function createRoom() {
        let name = document.getElementById('player-name').value.trim();
        if (!name) return alert('أدخل اسمك أولاً!');
        saveName(name); isHost = true;
        currentRoomCode = Math.floor(1000 + Math.random() * 9000).toString();
        let p = { name: name, team: 'us', isHost: true, type: 'حقيقي' };
        db.ref('baloot_rooms/' + currentRoomCode).set({
            status: 'waiting', scoreUs: 0, scoreThem: 0, dealerIndex: 0, turnIndex: 1, bidRound: 1, players: [p]
        }).then(() => { listenToRoom(); openWaiting(); });
    }

    function joinRoom() {
        let name = document.getElementById('player-name').value.trim();
        let code = document.getElementById('room-code-input').value.trim();
        if (!name || !code) return alert('أدخل التواصيل كاملاً!');
        saveName(name); currentRoomCode = code;
        db.ref('baloot_rooms/' + code).get().then(snap => {
            if (snap.exists()) {
                let pList = snap.val().players || [];
                if (pList.length >= 4) return alert('طاولة البلوت مكتملة!');
                let team = (pList.length % 2 === 0) ? 'us' : 'them';
                pList.push({ name: name, team: team, isHost: false, type: 'حقيقي' });
                db.ref('baloot_rooms/' + code + '/players').set(pList).then(() => { listenToRoom(); openWaiting(); });
            } else alert('الطاولة غير موجودة!');
        });
    }

    function listenToRoom() {
        db.ref('baloot_rooms/' + currentRoomCode).on('value', snap => {
            if (!snap.exists()) return;
            let data = snap.val();
            document.getElementById('score-us').innerText = data.scoreUs || 0;
            document.getElementById('score-them').innerText = data.scoreThem || 0;
            
            if (data.status === 'playing') renderGame(data);
            else updateWaitingUI(data.players || []);
        });
    }

    function updateWaitingUI(players) {
        document.getElementById('player-count').innerText = players.length;
        let c = document.getElementById('players-container'); c.innerHTML = '';
        players.forEach((p, i) => {
            c.innerHTML += `<div class="player-item"><span>${i+1}. ${p.name}</span><span class="badge">${p.team === 'us' ? 'فريقنا 🟩' : 'فريقهم 🟥'}</span></div>`;
        });
    }

    function startGame() {
        db.ref('baloot_rooms/' + currentRoomCode + '/players').get().then(snap => {
            let pList = snap.val();
            if (pList.length < 4) return alert('يجب اكتمال 4 لاعبين لبدء البلوت!');
            let deck = buildBalootDeck();
            
            // توزيع 3 كروت ثم كرتين (5 كروت لكل لاعب + كرت مكشوف)
            pList.forEach(p => { p.cards = [deck.pop(), deck.pop(), deck.pop(), deck.pop(), deck.pop()]; });
            let revealed = deck.pop();

            db.ref('baloot_rooms/' + currentRoomCode).update({
                status: 'playing', players: pList, revealedCard: revealed, deck: deck, turnIndex: 1, bidRound: 1
            });
        });
    }

    function buildBalootDeck() {
        let ranks = ['A', 'K', 'Q', 'J', '10', '9', '8', '7'];
        let deck = [];
        ranks.forEach(r => { SUITS.forEach(s => { deck.push({ rank: r, suit: s }); }); });
        return deck.sort(() => Math.random() - 0.5);
    }

    function renderGame(data) {
        document.getElementById('lobby-screen').classList.add('hidden');
        document.getElementById('waiting-screen').classList.add('hidden');
        document.getElementById('game-screen').classList.remove('hidden');

        let pList = data.players || [];
        document.getElementById('dealer-name').innerText = pList[data.dealerIndex] ? pList[data.dealerIndex].name : '-';
        document.getElementById('revealed-card').innerText = data.revealedCard ? `${data.revealedCard.rank}${data.revealedCard.suit}` : '-';

        let board = document.getElementById('game-board-players'); board.innerHTML = '';
        let myObj = null;

        pList.forEach((p, i) => {
            if (p.name === myName) myObj = p;
            let isTurn = (i === data.turnIndex);
            board.innerHTML += `
                <div class="player-item ${isTurn ? 'active-turn' : ''}">
                    <span>${p.name} (${p.team === 'us' ? 'فريقنا' : 'فريقهم'})</span>
                </div>`;
        });

        if (myObj && myObj.cards) {
            let mc = document.getElementById('my-cards'); mc.innerHTML = '';
            myObj.cards.forEach((c, idx) => {
                let isRed = (c.suit === '♥️' || c.suit === '♦️');
                mc.innerHTML += `<div class="playing-card ${isRed?'red':''}" onclick="playCard(${idx})">${c.rank}<br>${c.suit}</div>`;
            });
        }

        let myTurn = (pList[data.turnIndex] && pList[data.turnIndex].name === myName);
        if (myTurn) {
            document.getElementById('bidding-screen').classList.remove('hidden');
        } else {
            document.getElementById('bidding-screen').classList.add('hidden');
        }
    }

    function makeBid(type) {
        db.ref('baloot_rooms/' + currentRoomCode).get().then(snap => {
            let data = snap.val();
            if (type === 'pass') {
                data.turnIndex = (data.turnIndex + 1) % 4;
            } else {
                alert(`تم اختيار ${type} بنجاح!`);
            }
            db.ref('baloot_rooms/' + currentRoomCode).set(data);
        });
    }

    function playCard(index) {
        alert('تم لعب الورقة بنجاح على الفرشة!');
    }

    function startVsBots() {
        let name = document.getElementById('player-name').value.trim() || 'اللاعب';
        saveName(name);
        currentRoomCode = Math.floor(1000 + Math.random() * 9000).toString();
        let players = [
            { name: name, team: 'us', isHost: true, type: 'حقيقي' },
            { name: 'خصم 1 🤖', team: 'them', isHost: false, type: 'آلي' },
            { name: 'زملك 🤖', team: 'us', isHost: false, type: 'آلي' },
            { name: 'خصم 2 🤖', team: 'them', isHost: false, type: 'آلي' }
        ];
        db.ref('baloot_rooms/' + currentRoomCode).set({
            status: 'waiting', scoreUs: 0, scoreThem: 0, dealerIndex: 0, turnIndex: 1, bidRound: 1, players: players
        }).then(() => { listenToRoom(); openWaiting(); });
    }

    function openWaiting() {
        document.getElementById('lobby-screen').classList.add('hidden');
        document.getElementById('waiting-screen').classList.remove('hidden');
        document.getElementById('current-room-display').innerText = currentRoomCode;
    }
</script>

</body>
</html>
